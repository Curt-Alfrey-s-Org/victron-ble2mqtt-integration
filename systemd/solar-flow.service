[Unit]
Description=Solar flow GX-style dashboard (HA REST proxy)
Documentation=https://github.com/Curt-Alfrey-s-Org/victron-ble2mqtt-integration/blob/main/docs/SOLAR_FLOW_DASHBOARD.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ansible
Group=ansible
WorkingDirectory=/home/ansible/victron-ble2mqtt-integration
Environment=HA_BASE_URL=http://127.0.0.1:8123
Environment=HA_TOKEN_FILE=/home/ansible/alfa-ai/deploy/secrets/home-assistant/long-lived.token
Environment=SOLAR_FLOW_PORT=8765
# Bind all interfaces like HA :8123. ufw restricts LAN + tailscale0.
# 127.0.0.1 stays reachable so Tailscale Serve can proxy the same process.
# Do not use Funnel (public internet). Do not put the token in this file.
ExecStart=/usr/bin/python3 /home/ansible/victron-ble2mqtt-integration/scripts/solar_flow_server.py --lan --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
