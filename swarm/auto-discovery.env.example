# Copy to swarm/auto-discovery.env (git-ignored; do not commit) and adjust.
# Used by the swarm discovery stacks for non-secret discovery settings only.
# MQTT credentials live in swarm/ha-discovery.env (see ha-discovery.env.example).
TOPIC_ROOT=victron
DEVICE_NAME_PREFIX=Victron
# Optional comma-separated device IDs to limit discovery to (empty = all devices)
LIMIT_DEVICES=
